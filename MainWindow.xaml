<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Class="Tweakly.MainWindow" Title="Tweakly" Width="1360" Height="900" MinWidth="820" MinHeight="620" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource EnglishFont}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#2D2F43" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Background="#101119" FlowDirection="LeftToRight">
                <TextBlock Text="TWEAKLY" FontFamily="{StaticResource EnglishFont}" Foreground="#9FA2B9" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="22,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="―" Padding="16,7" Background="Transparent" BorderThickness="0" Click="Minimize_Click" AutomationProperties.Name="Minimize"/>
                    <Button Content="□" Padding="16,7" Background="Transparent" BorderThickness="0" Click="Maximize_Click" AutomationProperties.Name="Maximize"/>
                    <Button Content="×" Padding="17,7" Background="Transparent" BorderThickness="0" FontSize="19" Click="Close_Click" AutomationProperties.Name="Close"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" x:Name="AppLayout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#10121A" BorderBrush="#232635" BorderThickness="0,0,1,0">
                    <Grid Margin="16,23,16,17">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="7,0,0,27">
                            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" TextElement.FontFamily="{StaticResource EnglishFont}">
                                <Border Width="38" Height="38" CornerRadius="12" Background="#8F72EC">
                                    <TextBlock Text="T" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Tweakly" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="BrandSubtitle" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                        </StackPanel>
                        <Button Grid.Row="1" x:Name="OverviewButton" Style="{StaticResource NavButton}" Click="Overview_Click" Margin="0,0,0,16"/>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="CategoriesCaption" Style="{StaticResource Caption}" Margin="12,0,0,12"/>
                                <ItemsControl x:Name="CategoryNav">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource NavButton}" Tag="{Binding Id}" Click="Category_Click" Margin="0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="29"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="24"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="16"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Count}" FlowDirection="LeftToRight" FontFamily="{StaticResource EnglishFont}" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="3" Margin="0,14,0,0">
                            <Button x:Name="HistoryButton" Style="{StaticResource NavButton}" Click="History_Click"/>
                            <Button x:Name="AboutButton" Style="{StaticResource NavButton}" Click="About_Click"/>
                            <Border Background="#1C1B2D" CornerRadius="8" Padding="11" Margin="0,16,0,0">
                                <TextBlock x:Name="PortableNote" FontSize="11" Foreground="#BBAAFF"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" Margin="28,24,28,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock x:Name="PageEyebrow" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,7"/>
                            <TextBlock x:Name="PageTitle" FontSize="27" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="LanguageButton" Click="Language_Click" MinWidth="94" VerticalAlignment="Top"/>
                    </Grid>
                    <Border Grid.Row="1" x:Name="BusyBanner" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="BusyLabel" Foreground="{StaticResource AccentBrush}"/>
                            <ProgressBar Height="3" Margin="0,10,0,0" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="#252136"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="2" x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PageContent"/>
                    </ScrollViewer>
                    <DockPanel Grid.Row="3" Margin="0,18,0,0">
                        <TextBlock Text="v0.1.2" FontFamily="{StaticResource EnglishFont}" DockPanel.Dock="Right" Style="{StaticResource Caption}" FlowDirection="LeftToRight"/>
                        <TextBlock x:Name="FooterNote" Style="{StaticResource Caption}"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
